# No CompilationDatabase: clangd finds build/compile_commands.json, which is where a
# vanilla Zephyr build puts it. A sysbuild build (the NCS default) puts it in
# build/<project-dir>/, so for those uncomment the line below and set the name.
CompileFlags:
  # CompilationDatabase: build/zephyr-cpp-template

  # GCC-only flags from the Zephyr toolchain that clangd rejects.
  Remove:
    - -fno-reorder-functions
    - -fno-defer-pop
    - -fno-freestanding
    - --param=min-pagesize=*
    - -mfp16-format=*
    - -fno-printf-return-value
    - -fstrict-volatile-bitfields
    - -mlongcalls
    - -mtext-section-literals

Diagnostics:
  # Zephyr headers pull in transitively-used symbols by design.
  UnusedIncludes: None
  MissingIncludes: None
  ClangTidy:
    FastCheckFilter: Loose

Index:
  Background: Build
  StandardLibrary: true

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
