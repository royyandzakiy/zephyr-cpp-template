# Build output, including `-d` dirs like build_nrf5340dk.
# Anchored, since a bare build* would also ignore folders like docs/building/.
/build*/

# Twister output. Not twister*/, which would also ignore twister_harness/.
twister-out*/

# Python
**/.venv/
**/__pycache__/
**/.pytest_cache/

# Signing key. The private key must never be committed.
signing_key.pem

# Backup left by `ncs.py register --vscode`.
.vscode/settings.json.bak

# Local only, never committed.
private/
.devcontainer/setup-local.sh
.env
.claude/settings.local.json

# Editors and OS files.
*.swp
*~
.idea/
.DS_Store
Thumbs.db
