{
  "name": "nRF Connect SDK (C++)",

  // Built from the Dockerfile next to this file, so .devcontainer/ is a
  // self-contained drop-in. --platform here applies to the BUILD; the one in
  // runArgs applies to `docker run`.
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "options": ["--platform=linux/amd64"]
  },

  // --privileged claims the J-Link over libusb; SYS_PTRACE + unconfined seccomp
  // are for on-target debugging. On Windows, forward the probe first with
  // `usbipd attach --wsl --busid <id>` (see docs/setup/flash-monitor.md).
  "runArgs": [
    "--platform=linux/amd64",
    "--privileged",
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined"
  ],

  // The app is freestanding: it builds against whichever SDK is selected in the
  // extension rather than living inside the SDK tree.
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",

  "mounts": [
    // /root/ncs is the extension's default SDK location (~/ncs), so its
    // "Manage SDKs" UI writes straight into the shared volume.
    "source=ncs-sdks,target=/root/ncs,type=volume",
    // Persist ~/.ssh so the key survives rebuilds.
    "source=ncs-ssh,target=/root/.ssh,type=volume",
    // Live bind so a probe attached after start still appears.
    "source=/dev,target=/dev,type=bind"
  ],

  // Ensure an SSH key exists, then run .devcontainer/setup-local.sh if present
  // (gitignored; used for private SDK forks).
  "postCreateCommand": "ncs-ssh-key; if [ -f .devcontainer/setup-local.sh ]; then bash .devcontainer/setup-local.sh; fi",

  // The extension discovers SDKs from ~/.cmake/packages/Zephyr, which is
  // ephemeral, so re-register on every start.
  "postStartCommand": "ncs-register-sdks",

  "customizations": {
    "vscode": {
      "extensions": [
        "nordic-semiconductor.nrf-connect-extension-pack",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "marus25.cortex-debug",
        "twxs.cmake"
      ],
      "settings": {
        // Must match the volume mount above, or the extension installs into
        // /root/ncs but discovers toolchains elsewhere.
        "nrf-connect.toolchainManager.installDirectory": "/root/ncs",
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.cppStandard": "c++23"
      }
    }
  }
}
